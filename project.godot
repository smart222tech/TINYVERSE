; FOOD DASH — portrait arcade runner
; Godot 4.x project
config_version=5

[application]
config/name="FOOD DASH"
config/description="A colorful portrait food runner."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/version="0.2.0"

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.49, 0.78, 0.98, 1)

[rendering/textures/vram_compression]
import_etc2_astc=true
